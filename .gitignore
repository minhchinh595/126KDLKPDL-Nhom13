# Open Electricity NEM - local candidate data and experiments
data/raw/openelectricity/
data/processed/openelectricity/
data/experiments/openelectricity/

# Keep the NEM provenance manifest tracked
!data/openelectricity_manifest.md

# Raw database dumps stay local; only the sanitized, restore-tested handoff is eligible for Git.
/backups/*.dump
!/backups/electricity_analytics_nem_handoff_sanitized.dump

# Open Electricity NEM - local trained model artifacts
/BE/artifacts/electricity_nem_daily_kmeans.joblib
/BE/artifacts/electricity_nem_daily_demand_rf.joblib
