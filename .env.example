# Copy to .env. Replace the PostgreSQL password and generate separate secrets before use.
POSTGRES_DB=electricity_analytics_db
POSTGRES_USER=electricity_app
POSTGRES_PASSWORD=replace_with_a_local_password

# Host-side development URL; Compose overrides this inside Gateway to use postgres:5432.
DATABASE_URL=postgresql+psycopg://electricity_app:replace_with_a_local_password@127.0.0.1:5433/electricity_analytics_db
JWT_SECRET_KEY=
ACCESS_TOKEN_TTL_MINUTES=60
APP_ENV=development
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
DATASET_MAX_UPLOAD_BYTES=26214400
DATASET_SYNC_URL=

# Local-process defaults. Compose overrides these URLs with Docker service DNS names.
ANALYSIS_SERVICE_URL=http://127.0.0.1:8101
ANALYSIS_SERVICE_SECRET=
ANALYSIS_SERVICE_TIMEOUT_SECONDS=5
CLUSTERING_SERVICE_URL=http://127.0.0.1:8102
CLUSTERING_SERVICE_SECRET=
CLUSTERING_SERVICE_TIMEOUT_SECONDS=30
PREDICTION_SERVICE_URL=http://127.0.0.1:8103
PREDICTION_SERVICE_SECRET=
PREDICTION_SERVICE_TIMEOUT_SECONDS=120
CLASSIFICATION_SERVICE_URL=http://127.0.0.1:8104
CLASSIFICATION_SERVICE_SECRET=
CLASSIFICATION_SERVICE_TIMEOUT_SECONDS=120
INGESTION_SERVICE_URL=http://127.0.0.1:8105
INGESTION_SERVICE_SECRET=
INGESTION_SERVICE_TIMEOUT_SECONDS=30

# Model paths are local defaults; Compose mounts BE/artifacts at /app/artifacts.
CLUSTERING_MODEL_PATH=
PREDICTION_MODEL_PATH=
CLASSIFICATION_MODEL_PATH=

# Next.js embeds this public browser URL during `next build`.
NEXT_PUBLIC_API_URL=http://localhost:8001
