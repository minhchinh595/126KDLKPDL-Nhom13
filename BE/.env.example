APP_NAME=Electricity Consumption Analytics
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000

POSTGRES_DB=electricity_analytics_db
POSTGRES_USER=electricity_app
POSTGRES_PASSWORD=replace_with_a_local_password
DATABASE_URL=postgresql+psycopg://electricity_app:replace_with_a_local_password@127.0.0.1:5433/electricity_analytics_db
# Test fixture target only; use the dedicated `postgres-test` service, never production DATABASE_URL.
TEST_DATABASE_URL=postgresql+psycopg://electricity_test:replace_with_a_dedicated_test_password@127.0.0.1:5435/electricity_analytics_test
JWT_SECRET_KEY=
ACCESS_TOKEN_TTL_MINUTES=60
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
DATASET_MAX_UPLOAD_BYTES=26214400
DATASET_SYNC_URL=
INGESTION_SERVICE_URL=http://127.0.0.1:8105
INGESTION_SERVICE_SECRET=
INGESTION_SERVICE_TIMEOUT_SECONDS=30

# Optional persistent model artifact locations (defaults are under BE/artifacts)
CLUSTERING_MODEL_PATH=
PREDICTION_MODEL_PATH=
CLASSIFICATION_MODEL_PATH=

# Generate one private random value (at least 32 bytes) and use the same value
# for the Gateway and Analysis Service processes. Do not commit the real secret.
ANALYSIS_SERVICE_URL=http://127.0.0.1:8101
ANALYSIS_SERVICE_SECRET=
ANALYSIS_SERVICE_TIMEOUT_SECONDS=5

# Generate one private random value (at least 32 bytes) and share it between
# the Gateway and Clustering Service processes. Do not commit the real secret.
CLUSTERING_SERVICE_URL=http://127.0.0.1:8102
CLUSTERING_SERVICE_SECRET=
CLUSTERING_SERVICE_TIMEOUT_SECONDS=30

# Generate a separate private random value (at least 32 bytes) and share it
# between the Gateway and Prediction Service. Do not commit the real secret.
PREDICTION_SERVICE_URL=http://127.0.0.1:8103
PREDICTION_SERVICE_SECRET=
PREDICTION_SERVICE_TIMEOUT_SECONDS=120

# Generate a separate private random value (at least 32 bytes) and share it
# between the Gateway and Classification Service. Do not commit the real secret.
CLASSIFICATION_SERVICE_URL=http://127.0.0.1:8104
CLASSIFICATION_SERVICE_SECRET=
CLASSIFICATION_SERVICE_TIMEOUT_SECONDS=120

# The Gateway runs the Ingestion Service as a separate process in local development.
# Docker Compose replaces this URL with http://ingestion:8105.

DATASET_PATH=../data/raw/ember-monthly-generation.csv
PROCESSED_DATASET_PATH=../data/processed/vietnam_electricity_demand.csv
