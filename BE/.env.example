APP_NAME=Electricity Consumption Analytics
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000

POSTGRES_DB=electricity_analytics_db
POSTGRES_USER=electricity_app
POSTGRES_PASSWORD=replace_with_a_local_password
DATABASE_URL=postgresql+psycopg://electricity_app:replace_with_a_local_password@127.0.0.1:5433/electricity_analytics_db
JWT_SECRET_KEY=replace_with_at_least_32_random_bytes
ACCESS_TOKEN_TTL_MINUTES=60
APP_ENV=development
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
DATASET_MAX_UPLOAD_BYTES=26214400
DATASET_SYNC_URL=

# Optional persistent model artifact locations (defaults are under BE/artifacts)
CLUSTERING_MODEL_PATH=
PREDICTION_MODEL_PATH=
CLASSIFICATION_MODEL_PATH=

# Generate one private random value (at least 32 bytes) and use the same value
# for the Gateway and Analysis Service processes. Do not commit the real secret.
ANALYSIS_SERVICE_URL=http://127.0.0.1:8101
ANALYSIS_SERVICE_SECRET=
ANALYSIS_SERVICE_TIMEOUT_SECONDS=5

DATASET_PATH=../data/raw/ember-monthly-generation.csv
PROCESSED_DATASET_PATH=../data/processed/vietnam_electricity_demand.csv
